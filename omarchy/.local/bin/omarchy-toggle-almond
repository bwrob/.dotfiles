#!/usr/bin/env bash
set -euo pipefail

CURRENT="$(omarchy theme current 2>/dev/null || true)"

case "${CURRENT,,}" in
    "almond blossom")
        NEXT="Almond Blossom Mono"
        hyprsunset -t 4200 &>/dev/null &
        ;;
    *)
        NEXT="Almond Blossom"
        hyprsunset -i &>/dev/null &
        ;;
esac

omarchy theme set "$NEXT"
notify-send -a "Omarchy Theme" "Theme Switched" "$NEXT" -i preferences-desktop-theme 2>/dev/null || true
