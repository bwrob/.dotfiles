# Yazi Theme - Dynamically generated by Omarchy
# Mode: {{ mode }} | Accent: {{ accent }}

[manager]
cwd = { fg = "{{ accent }}" }

# Hovered item
hovered         = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
preview_hovered = { underline = true }

# Selection
selected = { fg = "{{ bright_foreground }}", bg = "{{ selection }}", bold = true }

# Find
find_keyword  = { fg = "{{ yellow }}", italic = true, bold = true }
find_position = { fg = "{{ magenta }}" }

# Marker
marker_selected = { fg = "{{ green }}" }
marker_copied   = { fg = "{{ yellow }}" }
marker_cut      = { fg = "{{ red }}" }

# Tab
tab_active   = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
tab_inactive = { fg = "{{ muted }}", bg = "{{ darker_background }}" }

# Count
count_selected = { fg = "{{ yellow }}", bg = "{{ selection }}" }
count_copied   = { fg = "{{ green }}", bg = "{{ selection }}" }
count_cut      = { fg = "{{ red }}", bg = "{{ selection }}" }

# Border
border_symbol = "│"
border_style  = { fg = "{{ selection }}" }

# Syntect theme (syntax highlighting in preview)
syntect_theme = ""

[status]
separator_open  = ""
separator_close = ""

# Mode indicator
mode_normal = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
mode_select = { fg = "{{ background }}", bg = "{{ green }}", bold = true }
mode_unset  = { fg = "{{ background }}", bg = "{{ red }}", bold = true }

# Progress
progress_label  = { fg = "{{ bright_foreground }}", bold = true }
progress_normal = { fg = "{{ accent }}", bg = "{{ darker_background }}" }
progress_error  = { fg = "{{ red }}", bg = "{{ darker_background }}" }

# Permissions
permissions_t = { fg = "{{ blue }}" }
permissions_r = { fg = "{{ yellow }}" }
permissions_w = { fg = "{{ red }}" }
permissions_x = { fg = "{{ green }}" }
permissions_s = { fg = "{{ magenta }}" }

[input]
border   = { fg = "{{ accent }}" }
title    = { fg = "{{ foreground }}" }
value    = { fg = "{{ bright_foreground }}" }
selected = { reversed = true }

[select]
border   = { fg = "{{ accent }}" }
active   = { fg = "{{ accent }}", bold = true }
inactive = { fg = "{{ muted }}" }

[tasks]
border  = { fg = "{{ accent }}" }
title   = { fg = "{{ foreground }}" }
hovered = { fg = "{{ accent }}", underline = true }

[which]
mask            = { bg = "{{ darker_background }}" }
cand            = { fg = "{{ cyan }}" }
rest            = { fg = "{{ muted }}" }
desc            = { fg = "{{ foreground }}" }
separator       = " ➜ "
separator_style = { fg = "{{ selection }}" }

[help]
on      = { fg = "{{ green }}" }
run     = { fg = "{{ magenta }}" }
desc    = { fg = "{{ foreground }}" }
hovered = { bg = "{{ selection }}", fg = "{{ bright_foreground }}" }
footer  = { fg = "{{ accent }}" }

[icon]
prepend_conds = [
	{ if = "dir & hovered", text = "", fg = "{{ accent }}" },
	{ if = "dir", text = "", fg = "{{ accent }}" },
]
prepend_dirs = [
	{ name = ".config", text = "", fg = "{{ accent }}" },
	{ name = ".git", text = "", fg = "{{ accent }}" },
	{ name = ".github", text = "", fg = "{{ accent }}" },
	{ name = ".npm", text = "", fg = "{{ accent }}" },
	{ name = "Desktop", text = "", fg = "{{ accent }}" },
	{ name = "Development", text = "", fg = "{{ accent }}" },
	{ name = "Documents", text = "", fg = "{{ accent }}" },
	{ name = "Downloads", text = "", fg = "{{ accent }}" },
	{ name = "Library", text = "", fg = "{{ accent }}" },
	{ name = "Movies", text = "", fg = "{{ accent }}" },
	{ name = "Music", text = "", fg = "{{ accent }}" },
	{ name = "Pictures", text = "", fg = "{{ accent }}" },
	{ name = "Public", text = "", fg = "{{ accent }}" },
	{ name = "Videos", text = "", fg = "{{ accent }}" },
]

[filetype]
rules = [
	# Images
	{ mime = "image/*", fg = "{{ yellow }}" },
	# Media
	{ mime = "video/*", fg = "{{ magenta }}" },
	{ mime = "audio/*", fg = "{{ yellow }}" },
	# Archives
	{ mime = "application/*zip*", fg = "{{ orange }}" },
	{ mime = "application/x-tar", fg = "{{ orange }}" },
	{ mime = "application/x-bzip2", fg = "{{ orange }}" },
	{ mime = "application/x-7z-compressed", fg = "{{ orange }}" },
	{ mime = "application/x-rar", fg = "{{ orange }}" },
	# Documents
	{ mime = "application/pdf", fg = "{{ red }}" },
	# Code & Configs
	{ mime = "text/*", fg = "{{ foreground }}" },
	{ mime = "application/json", fg = "{{ yellow }}" },
	{ mime = "application/x-sh", fg = "{{ green }}" },
	# Directories & Empty
	{ mime = "inode/directory", fg = "{{ accent }}", bold = true },
	{ mime = "inode/x-empty", fg = "{{ muted }}" },
]
