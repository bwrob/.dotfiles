color-link default "{{ foreground }},{{ background }}"
color-link comment "italic {{ muted }}"

color-link identifier "{{ blue }}"
color-link identifier.class "bold {{ yellow }}"
color-link identifier.var "{{ foreground }}"

color-link constant "{{ magenta }}"
color-link constant.number "{{ magenta }}"
color-link constant.string "{{ yellow }}"

color-link symbol "{{ light_foreground }}"
color-link symbol.brackets "{{ bright_foreground }}"
color-link symbol.tag "{{ red }}"

color-link type "{{ orange }}"
color-link type.keyword "bold {{ red }}"

color-link special "{{ blue }}"
color-link statement "bold {{ red }}"
color-link preproc "{{ orange }}"

color-link underlined "underline {{ accent }}"
color-link error "bold {{ bright_red }}"
color-link todo "bold {{ bright_yellow }}"

color-link diff-added "{{ green }}"
color-link diff-modified "{{ yellow }}"
color-link diff-deleted "{{ red }}"

color-link gutter-error "{{ bright_red }}"
color-link gutter-warning "{{ yellow }}"

color-link statusline "bold {{ bright_foreground }},{{ selection }}"
color-link tabbar "{{ foreground }},{{ dark_background }}"
color-link indent-char "{{ selection }}"
color-link line-number "{{ muted }}"
color-link current-line-number "bold {{ bright_foreground }}"

color-link cursor-line "{{ lighter_background }}"
color-link color-column "{{ lighter_background }}"
color-link selection "{{ bright_foreground }},{{ selection }}"
color-link type.extended "default"
