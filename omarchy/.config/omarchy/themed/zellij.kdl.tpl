// Zellij Theme - Dynamically generated by Omarchy
// Mode: {{ mode }} | Accent: {{ accent }}

themes {
    omarchy {
        fg "{{ foreground }}"
        bg "{{ background }}"
        black "{{ darker_background }}"
        red "{{ red }}"
        green "{{ green }}"
        yellow "{{ yellow }}"
        blue "{{ blue }}"
        magenta "{{ magenta }}"
        cyan "{{ cyan }}"
        white "{{ bright_foreground }}"
        orange "{{ orange }}"
    }
}
