/* Zen Browser Theme - Dynamically generated by Omarchy */
/* Mode: {{ mode }} | Accent: {{ accent }} */

:root {
  /* Accent & Primary Colors */
  --zen-primary-color: {{ accent }} !important;
  --zen-colors-primary: {{ accent }} !important;
  --zen-colors-primary-foreground: {{ background }} !important;

  /* Surfaces & Backgrounds */
  --zen-main-browser-background: {{ background }} !important;
  --zen-dialog-background: {{ darker_background }} !important;
  --zen-urlbar-background: {{ darker_background }} !important;
  --zen-colors-input-bg: {{ darker_background }} !important;

  /* UI Borders & Interactive Elements */
  --zen-colors-secondary: {{ muted }} !important;
  --zen-colors-tertiary: {{ darker_background }} !important;
  --zen-colors-hover-bg: {{ selection }} !important;
  --zen-colors-border: {{ selection }} !important;
  --zen-colors-border-contrast: {{ muted }} !important;

  /* Toolbar & Sidebar */
  --zen-toolbar-element-bg: {{ darker_background }} !important;
  --zen-toolbar-element-bg-hover: {{ selection }} !important;
  --zen-sidebar-notification-bg: {{ accent }} !important;
  --zen-sidebar-themed-icon-fill: {{ foreground }} !important;

  /* Standard Firefox/Gecko Theme properties */
  --toolbar-bgcolor: {{ darker_background }} !important;
  --toolbar-color: {{ foreground }} !important;
  --lwt-accent-color: {{ background }} !important;
  --lwt-text-color: {{ foreground }} !important;
  --lwt-selected-tab-background-color: {{ selection }} !important;
  --arrowpanel-background: {{ darker_background }} !important;
  --arrowpanel-color: {{ foreground }} !important;
  --arrowpanel-border-color: {{ selection }} !important;
}

/* Tab Bar & Active Tab Highlights */
#tabbrowser-tabs .tabbrowser-tab[selected="true"] .tab-background {
  background-color: {{ selection }} !important;
  border-bottom: 2px solid {{ accent }} !important;
}

/* URL Bar styling */
#urlbar-background {
  background-color: {{ darker_background }} !important;
  border: 1px solid {{ selection }} !important;
}

#urlbar[focused="true"] > #urlbar-background {
  border-color: {{ accent }} !important;
}
