color-link default "#f7f5f0,#111317"
color-link comment "italic #949087"

color-link identifier "#7eb8da"
color-link identifier.class "bold #f2cc81"
color-link identifier.var "#f7f5f0"

color-link constant "#e8a5b8"
color-link constant.number "#e8a5b8"
color-link constant.string "#f2cc81"

color-link symbol "#e2dfd7"
color-link symbol.brackets "#ffffff"
color-link symbol.tag "#f07178"

color-link type "#f09f67"
color-link type.keyword "bold #f07178"

color-link special "#7eb8da"
color-link statement "bold #f07178"
color-link preproc "#f09f67"

color-link underlined "underline #7eb8da"
color-link error "bold #ff8b92"
color-link todo "bold #ffe09e"

color-link diff-added "#a8cc8c"
color-link diff-modified "#f2cc81"
color-link diff-deleted "#f07178"

color-link gutter-error "#ff8b92"
color-link gutter-warning "#f2cc81"

color-link statusline "bold #ffffff,#2b333d"
color-link tabbar "#f7f5f0,#0b0d10"
color-link indent-char "#2b333d"
color-link line-number "#949087"
color-link current-line-number "bold #ffffff"

color-link cursor-line "#1d2026"
color-link color-column "#1d2026"
color-link selection "#ffffff,#2b333d"
color-link type.extended "default"
